<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework Combat Runtime -->
    <Compile Include="../../Assets/_Framework/Combat/Runtime/*.cs"
             Link="Framework/Combat/Runtime/%(Filename)%(Extension)" />

    <!-- Framework Combat Tests -->
    <Compile Include="../../Assets/_Framework/Combat/Tests/ResourceComponentTests.cs"
             Link="Tests/ResourceComponentTests.cs" />

    <!-- ECS Runtime dependency -->
    <Compile Include="../../Assets/_Framework/ECS/Runtime/*.cs"
             Link="Framework/ECS/Runtime/%(Filename)%(Extension)" />

    <!-- Logging Runtime dependency -->
    <Compile Include="../../Assets/_Framework/Logging/Runtime/*.cs"
             Link="Framework/Logging/Runtime/%(Filename)%(Extension)" />

    <!-- Serialization Runtime dependency -->
    <Compile Include="../../Assets/_Framework/Serialization/Runtime/*.cs"
             Link="Framework/Serialization/Runtime/%(Filename)%(Extension)"
             Exclude="../../Assets/_Framework/Serialization/Runtime/ComponentSerializerBase.cs;../../Assets/_Framework/Serialization/Runtime/IComponentSerializer.cs;../../Assets/_Framework/Serialization/Runtime/IComponentSerializerRegistry.cs" />
  </ItemGroup>
</Project>
